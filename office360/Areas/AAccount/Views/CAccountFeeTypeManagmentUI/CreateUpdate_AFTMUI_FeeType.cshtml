
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using (Html.BeginForm())
{
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                    <h4>@ViewBag.Title</h4>
                </div>
            </div>
            <nav class="breadcrumb-one" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);">Accounts</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);">Fee</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <form>
        @if (ViewBag.DB_OperationType == nameof(office360.Models.General.DB_OperationType.UPDATE_DATA_INTO_DB))
        {
            <div class="card" style="margin-top:1%;width:100%">
                <div class="card-body">

                    <div class="row mb-0">
                        <div class="col-sm-12 col-md-8">
                            <div class="form-group">
                                @Html.Label("Fee Type ( For Edit )", new { @class = "col-form-label", @for = "DropDownListFeeType" })
                                @Html.DropDownList("DropDownListFeeType", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListFeeType" })
                                <button type="button" class="btn btn-info" id="ButtonSubmitGetInfoForEdit">
                                    <i class="fa fa-sync-alt"></i> Load Information
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="card" style="margin-top:1%;width:100%">
            <div class="card-body">
                <h3 style="font-family: 'Bahnschrift'; font-weight: bolder; color: navy">Fee Type Detail</h3>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Description", new { @class = "col-form-label", @for = "TextBoxDescription" })
                            @Html.TextBox("TextBoxDescription", null, new { @class = "form-control", placeholder = "Please Enter Description Here!", @id = "TextBoxDescription" })
                        </div>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Fee Category", new { @class = "col-form-label", @for = "DropDownListFeeCategory" })
                            @Html.DropDownList("DropDownListFeeCategory", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListFeeCategory" })
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Charging Method", new { @class = "col-form-label", @for = "DropDownListChargingMethod" })
                            @Html.DropDownList("DropDownListChargingMethod", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListChargingMethod" })
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-12 col-md-3" id="DivCheckBoxIsOnAdmission">
                        <div class="form-group">
                            <div class="n-chk">
                                <label class="new-control new-checkbox new-checkbox-rounded checkbox-info">
                                    @Html.CheckBox("CheckBoxIsOnAdmission", new { @class = "new-control-input", id = "CheckBoxIsOnAdmission" })
                                    <span class="new-control-indicator"></span>Is On Admission
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3">
                        <div class="form-group">
                            <div class="n-chk">
                                <label class="new-control new-checkbox new-checkbox-rounded checkbox-info">
                                    @Html.CheckBox("CheckBoxIsSecurity", new { @class = "new-control-input", id = "CheckBoxIsSecurity" })
                                    <span class="new-control-indicator"></span>Is Security
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3">
                        <div class="form-group">
                            <div class="n-chk">
                                <label class="new-control new-checkbox new-checkbox-rounded checkbox-info">
                                    @Html.CheckBox("CheckBoxIsRefundable", new { @class = "new-control-input", id = "CheckBoxIsRefundable" })
                                    <span class="new-control-indicator"></span>Is Refundable
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-3">
                        <div class="form-group">
                            <div class="n-chk">
                                <label class="new-control new-checkbox new-checkbox-rounded checkbox-info">
                                    @Html.CheckBox("CheckBoxIsDiscount", new { @class = "new-control-input", id = "CheckBoxIsDiscount" })
                                    <span class="new-control-indicator"></span>Is Discount
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
              
                <div class="row mb-0" id="DivOtherFeeChartOfAccount" style="display:none">
                    <div class="col-sm-12 col-md-6" id="DivDropDownListRevenueAccount">
                        <div class="form-group">
                            @Html.Label("Revenue Account", new { @class = "col-form-label", @for = "DropDownListRevenueAccount" })
                            @Html.DropDownList("DropDownListRevenueAccount", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListRevenueAccount" })
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6" id="DivDropDownListAssetAccount">
                        <div class="form-group">
                            @Html.Label("Asset Account", new { @class = "col-form-label", @for = "DropDownListAssetAccount" })
                            @Html.DropDownList("DropDownListAssetAccount", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListAssetAccount" })
                        </div>
                    </div>

                    <div class="col-sm-12 col-md-6" id="DivDropDownListLiabilityAccount">
                        <div class="form-group">
                            @Html.Label("Liability Account", new { @class = "col-form-label", @for = "DropDownListLiabilityAccount" })
                            @Html.DropDownList("DropDownListLiabilityAccount", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListLiabilityAccount" })
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6" id="DivDropDownListCostOfSaleAccount">
                        <div class="form-group">
                            @Html.Label("Cost Of Sale Account", new { @class = "col-form-label", @for = "DropDownListCostOfSaleAccount" })
                            @Html.DropDownList("DropDownListCostOfSaleAccount", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListCostOfSaleAccount" })
                        </div>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Remarks", new { @class = "col-form-label", @for = "TextBoxRemarks" })
                            @Html.TextBox("TextBoxRemarks", null, new { @class = "form-control", placeholder = "Please Enter Remarks Here!", @id = "TextBoxRemarks" })
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>
    @Html.TextBox("HiddenFieldFeeTypeGuID", null, new { @class = "form-control", Value = ViewBag.AdmissionSessionGuIDGuID, hidden = true, @id = "HiddenFieldFeeTypeGuID" })
    @Html.TextBox("HiddenFieldDB_OperationType", null, new { @class = "form-control", Value = ViewBag.DB_OperationType, hidden = true, @id = "HiddenFieldDB_OperationType" })
    <div class="card-footer">
        <div class="col-sm-12 form-group">
            <div class="card-heading" id="DivButtonSubmitDown" style="display:none">
                <input type="button" class="btn btn-info" id="ButtonSubmitDown" value="Sumbit" />
                <i class="fa fa-arrow-up"></i>
            </div>
            <div class="card-heading" id="DivButtonUpdateDown" style="display:none">
                <input type="button" class="btn btn-warning" id="ButtonUpdateDown" value="Update" />
                <i class="fa fa-arrow-up"></i>
            </div>
        </div>
    </div>
}


<script src="~/Areas/AAccount/Script/CAccountFeeTypeManagmentUI_Script/CreateUpdate_AFTMUI_FeeType.js"></script>