
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm())
{

    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                    <h4>@ViewBag.Title</h4>
                </div>
            </div>
            <nav class="breadcrumb-one" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);">Student</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="javascript:void(0);">Enrollment(s)</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span>@ViewBag.Title</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <form>
        <div class="card" style="margin-top:1%;width:100%">
            <div class="card-body">
                <h3 style="font-family: 'Bahnschrift'; font-weight: bolder; color: navy">Question Detail</h3>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Campus", new { @class = "col-form-label", @for = "DropDownListCampus" })
                            @Html.DropDownList("DropDownListCampus", Enumerable.Empty<SelectListItem>(), new { @class = "form -control select2", @data_toggle = "select2", id = "DropDownListCampus" })
                        </div>
                    </div>
                </div>

                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Class", new { @class = "col-form-label", @for = "DropDownListClass" })
                            @Html.DropDownList("DropDownListClass", Enumerable.Empty<SelectListItem>(), new { @class = "form -control select2", @data_toggle = "select2", id = "DropDownListClass" })
                        </div>
                    </div>

                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Subject", new { @class = "col-form-label", @for = "DropDownListSubject" })
                            @Html.DropDownList("DropDownListSubject", Enumerable.Empty<SelectListItem>(), new { @class = "form -control select2", @data_toggle = "select2", id = "DropDownListSubject" })
                        </div>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Question Type", new { @class = "col-form-label", @for = "DropDownListQuestionType" })
                            @Html.DropDownList("DropDownListQuestionType", new List<SelectListItem>
                                 {
                                     new SelectListItem { Value = "0", Text = "Select An Option"},
                                     new SelectListItem { Value = "1", Text = "MCQ" },
                                     new SelectListItem { Value = "2", Text = "Fill In The Blanks" },
                                     new SelectListItem { Value = "3", Text = "True / False" },
                                     new SelectListItem { Value = "4", Text = "Match The Coloumn" },
                                     new SelectListItem { Value = "5", Text = "Diagram / Mindmap / Flow Chart" },
                                     new SelectListItem { Value = "6", Text = "Short Question" },
                                     new SelectListItem { Value = "7", Text = "Long Question" },
                                }, new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListQuestionType" })
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Option Limit", new { @class = "col-form-label", @for = "DropDownListOptionLimit" })
                            @Html.DropDownList("DropDownListOptionLimit", new List<SelectListItem>
                                 {
                                     new SelectListItem { Value = "0", Text = "Select An Option"},
                                     new SelectListItem { Value = "1", Text = "1" },
                                     new SelectListItem { Value = "2", Text = "2" },
                                     new SelectListItem { Value = "3", Text = "3" },
                                     new SelectListItem { Value = "4", Text = "4" },
                                     new SelectListItem { Value = "5", Text = "5" },
                                }, new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListOptionLimit" })
                        </div>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Chapter", new { @class = "col-form-label", @for = "TextBoxChapter" })
                            @Html.TextBox("TextBoxChapter", null, new { @class = "form-control", placeholder = "Please Enter Chapter Here!", @id = "TextBoxChapter" })
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Description", new { @class = "col-form-label", @for = "TextBoxDescription" })
                            @Html.TextArea("TextBoxDescription", null, new { @class = "form-control", placeholder = "Please Enter Description Here!", @id = "TextBoxDescription" })
                        </div>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Correct Answer", new { @class = "col-form-label" })
                            @Html.TextArea("CorrectAnswer", null, new { @class = "form-control", placeholder = "Final Answer for Grading", id = "TextBoxAnswer" })
                        </div>
                    </div>
                </div>
                <div id="ContainerDynamicOption"></div>
                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Remarks", new { @class = "col-form-label", @for = "TextBoxRemarks" })
                            @Html.TextBox("TextBoxRemarks", null, new { @class = "form-control", placeholder = "Please Enter Remarks Here!", @id = "TextBoxRemarks" })
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
    <div class="card-footer">
        <div class="col-sm-12 form-group">
            <div class="card-heading" id="DivButtonSubmitDown" style="display:none">
                <input type="button" class="btn btn-info" id="ButtonSubmitDown" value="Sumbit" />
                <i class="fa fa-arrow-up"></i>
            </div>
            <div class="card-heading" id="DivButtonUpdateDown" style="display:none">
                <input type="button" class="btn btn-warning" id="ButtonUpdateDown" value="Update" />
                <i class="fa fa-arrow-up"></i>
            </div>
        </div>
    </div>
}


<script src="~/Areas/AAcademic/Script/CAcademicQuestionManagmentUI_Script/CreateUpdate_AQMUI_Question.js"></script>
<script>
    document.getElementById('DifficultySlider').addEventListener('input', function (e) {
        const val = e.target.value;
        const badge = document.getElementById('DifficultyBadge');
        if (val == 1) { badge.innerText = "EASY"; badge.style.background = "#1abc9c"; }
        else if (val == 2) { badge.innerText = "MEDIUM"; badge.style.background = "#e2a03f"; }
        else { badge.innerText = "HARD"; badge.style.background = "#e7515a"; }
    });
</script>