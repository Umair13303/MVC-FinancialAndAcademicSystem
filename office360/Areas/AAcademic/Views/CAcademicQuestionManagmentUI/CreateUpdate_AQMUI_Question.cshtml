@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm())
{
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                    <h4>@ViewBag.Title</h4>
                </div>
            </div>
            <nav class="breadcrumb-one" aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0);">Academic</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0);">Questions</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><span>@ViewBag.Title</span></li>
                </ol>
            </nav>
        </div>
    </div>
    <form>
        @if (ViewBag.DB_OperationType == nameof(office360.Models.General.DB_OperationType.UPDATE_DATA_INTO_DB))
        {
            <div class="card" style="margin-top:1%;width:100%">
                <div class="card-body">
                    <div class="row mb-0">
                        <div class="col-sm-12 col-md-8">
                            <div class="form-group">
                                @Html.Label("Questions ( For Edit )", new { @class = "col-form-label", @for = "DropDownListQuestions" })
                                @Html.DropDownList("DropDownListQuestions", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListQuestions" })
                                <button type="button" class="btn btn-info" id="ButtonSubmitGetInfoForEdit">
                                    <i class="fa fa-sync-alt"></i> Load Information
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    <div class="card" style="margin-top:1%;width:100%">
        <div class="card-body">
            <div class="row mb-0">
                <div class="col-sm-12 col-md-6">
                    <div class="form-group">
                        @Html.Label("Question Type", new { @class = "col-form-label", @for = "DropDownListQuestionType" })
                        @Html.DropDownList("DropDownListQuestionType", Enumerable.Empty<SelectListItem>(), new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListQuestionType" })
                    </div>
                </div>
                <div class="col-sm-12 col-md-5" id="DivDropDownListOptionLimit" style="display:none">
                    <div class="form-group">
                        @Html.Label("Option Limit", new { @class = "col-form-label", @for = "DropDownListOptionLimit" })
                        @Html.DropDownList("DropDownListOptionLimit", new List<SelectListItem>
                         {
                             new SelectListItem { Value = "0", Text = "Select An Option" },
                                                                        new SelectListItem { Value = "1", Text = "1" },
                                                                        new SelectListItem { Value = "2", Text = "2" },
                                                                        new SelectListItem { Value = "3", Text = "3" },
                                                                        new SelectListItem { Value = "4", Text = "4" },
                         },
                         new { @class = "form-control select2", @data_toggle = "select2", id = "DropDownListOptionLimit" })
                    </div>
                </div>

                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Question Description", new { @class = "col-form-label", @for = "TextBoxDescription" })
                            @Html.TextBox("TextBoxDescription", null, new { @class = "form-control", placeholder = "Please Enter Question Description Here!", @id = "TextBoxDescription" })
                        </div>
                    </div>
                </div>
                <div id="ContainerOption" class="mt-3"></div>

                <div class="row mb-0">
                    <div class="col-sm-12 col-md-6">
                        <div class="form-group">
                            @Html.Label("Correct Answer", new { @class = "col-form-label", @for = "TextBoxCorrectAnswer" })
                            @Html.TextBox("TextBoxCorrectAnswer", null, new { @class = "form-control", placeholder = "Please Enter Correct Answer Here!", @id = "TextBoxCorrectAnswer" })
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
    </form>
    <div class="card-footer">
        <div class="col-sm-12 form-group">
            <div class="card-heading" id="DivButtonSubmitDown" style="display:none">
                <input type="button" class="btn btn-info" id="ButtonSubmitDown" value="Sumbit" />
                <i class="fa fa-arrow-up"></i>
            </div>
            <div class="card-heading" id="DivButtonUpdateDown" style="display:none">
                <input type="button" class="btn btn-warning" id="ButtonUpdateDown" value="Update" />
                <i class="fa fa-arrow-up"></i>
            </div>
        </div>
    </div>

}
